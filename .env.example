# Copiá como .env.local para desarrollo. En Vercel van en Settings -> Environment Variables.
# Nada de esto es obligatorio: sin ninguna variable el sitio funciona con datos de ejemplo.

# El link de invitación al Discord. Es LA conversión del sitio: sin esto, el botón
# principal no lleva a ningún lado. Usá una invitación que no expire.
NEXT_PUBLIC_URL_DISCORD=

# El dominio, para los links al compartir y el SEO (canonical, sitemap, robots).
# Si no la cargás, el sitio usa este mismo valor por defecto, así que olvidársela no rompe nada.
NEXT_PUBLIC_URL_SITIO=https://kripta.infinixapp.com

# URL del panel, para mostrar el ranking y los torneos reales en vez de los de ejemplo.
# El sitio le pega a {PANEL_API_URL}/publico/datos, que el panel ya expone.
# Sin barra al final. Ej: https://monsterland-panel.vercel.app
PANEL_API_URL=

# Acceso de jugadores con Supabase Auth. La publishable key es pública por diseño; nunca uses
# acá la service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# El mismo secreto largo y aleatorio en kripta-web y monsterland-panel. Viaja sólo de servidor
# a servidor para crear o vincular la ficha después de que Supabase confirmó Discord.
KRIPTA_SYNC_SECRET=

# Automatización privada de escenas. La base es independiente de Supabase Auth y se usa sólo
# para Telegram, Gemini y Veo; no reemplaza las tablas operativas del panel.
DATABASE_URL=
# Sólo para runtimes que no tienen instalada la CA del pooler compartido de Supabase.
# La conexión sigue cifrada; preferir una CA con sslmode=verify-full cuando sea posible.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Automatización privada de escenas. Ninguna de estas variables lleva NEXT_PUBLIC_;
# pertenecen al servidor y nunca deben aparecer en el navegador ni en Telegram.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Modelo separado para generar previews de imagen en Telegram. Puede requerir cuota/facturacion Gemini.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
VEO_MODEL=veo-3.1-generate-preview
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por coma. El bot ignora a cualquier otra persona.
TELEGRAM_ADMIN_IDS=
# Sólo letras, números, guion y guion bajo. Generá valores largos y distintos.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
AUTOMATION_DAILY_LIMIT=3
# URL HTTPS permanente del handler; el túnel temporal sirve para probar, no para producción.
TELEGRAM_WEBHOOK_URL=
