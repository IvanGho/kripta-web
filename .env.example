# Copiá como .env.local para desarrollo. En Vercel van en Settings -> Environment Variables.
# Nada de esto es obligatorio: sin ninguna variable el sitio funciona con datos de ejemplo.

# El link de invitación al Discord. Es LA conversión del sitio: sin esto, el botón
# principal no lleva a ningún lado. Usá una invitación que no expire.
NEXT_PUBLIC_URL_DISCORD=

# El dominio, para los links al compartir y el SEO (canonical, sitemap, robots).
# Si no la cargás, el sitio usa este mismo valor por defecto, así que olvidársela no rompe nada.
NEXT_PUBLIC_URL_SITIO=https://kripta.infinixapp.com

# URL del panel, para mostrar el ranking y los torneos reales en vez de los de ejemplo.
# El sitio le pega a {PANEL_API_URL}/publico/datos, que el panel ya expone.
# Sin barra al final. Ej: https://monsterland-panel.vercel.app
PANEL_API_URL=

# Acceso de jugadores con Supabase Auth. La publishable key es pública por diseño; nunca uses
# acá la service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# El mismo secreto largo y aleatorio en kripta-web y monsterland-panel. Viaja sólo de servidor
# a servidor para crear/vincular la ficha cuando Discord ya fue confirmado por Supabase.
KRIPTA_SYNC_SECRET=
